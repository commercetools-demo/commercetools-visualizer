{
  "name": "visualizer",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "build": "mc-scripts build",
    "start": "mc-scripts start",
    "login": "mc-scripts login",
    "sync": "mc-scripts config:sync",
    "compile-html": "mc-scripts compile-html",
    "compile-html:local": "MC_APP_ENV=development mc-scripts compile-html --transformer @commercetools-frontend/mc-dev-authentication/transformer-local.js",
    "start:prod:local": "npm run compile-html:local && mc-scripts serve",
    "extract-intl": "formatjs extract --format=./intl-formatter.js --out-file=./src/i18n/data/core.json 'src/**/!(*.spec|*.d).(ts|tsx)'",
    "test": "jest --config jest.test.config.js",
    "test:watch": "jest --config jest.test.config.js --watch",
    "lint": "eslint . --format eslint-formatter-pretty",
    "format": "prettier --write '**/*.{js,ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "versions:test-data": "manypkg upgrade @commercetools-test-data",
    "generate-types:ctp": "node ./scripts/login.js && graphql-codegen -r ./scripts/load-env.js --config codegen.ctp.yml",
    "generate-types:chakra": "chakra typegen node_modules/@commercetools/nimbus/dist/theme.es.js",
    "postinstall": "npm run generate-types:chakra"
  },
  "dependencies": {
